# 한국투자증권 KIS Developers (https://apiportal.koreainvestment.com) — 복사해서 .env 로 저장
KIS_MODE=paper              # paper=모의투자, real=실전
KIS_APP_KEY=발급받은_앱키
KIS_APP_SECRET=발급받은_앱시크릿
KIS_ACCOUNT=12345678-01     # 모의투자 계좌번호 (앞 8자리-뒤 2자리). 모의/실전 계좌번호가 다르니 KIS_MODE 와 맞출 것
KIS_PHONE=01012345678       # 해외주식 주문 시 연락처 (선택)

# 자동 매도: 평일 장 마감 전 지역별 1회 매도 규칙 판정 → 지정가 매도 (국내 15:10 KST, 미국 15:30 뉴욕)
AUTO_SELL=0            # 1 이면 켬
AUTO_SELL_DRY=1        # 1 이면 드라이런(주문 안 보내고 기록·알림만). 실주문은 0
AUTO_SELL_MAX_PER_DAY=3
AUTO_SELL_LIMIT_PCT=0.5   # 지정가 = 현재가 × (1 − 0.5%)
# AUTO_SELL_TIME_KR=15:10
# AUTO_SELL_TIME_US=15:30
